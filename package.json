{
  "name": "nightwater",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "test:browser": "node scripts/with-server.mjs scripts/browser-check.mjs",
    "test:lifecycle": "node scripts/with-server.mjs scripts/lifecycle-check.mjs",
    "test:music": "node scripts/music-check.mjs",
    "test:album": "node scripts/with-server.mjs --music scripts/album-check.mjs",
    "verify": "node scripts/verify.mjs --staged",
    "verify:full": "node scripts/verify.mjs --full",
    "music": "docker compose run --rm --build music",
    "music:serve": "docker compose up -d cdn",
    "music:push": "node scripts/music-sync.mjs push",
    "music:pull": "node scripts/music-sync.mjs pull",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/three": "0.185.4",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2"
  }
}
